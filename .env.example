# Immich
# If this container shares Immich's Docker network, use the Immich service name:
IMMICH_URL=http://immich_server:2283
# Otherwise use the published host port:
# IMMICH_URL=http://host.docker.internal:2283
IMMICH_API_KEY=your_immich_api_key

# Web UI (published on 127.0.0.1:8095 by default)
# PORT=8095
# DB_PATH=/data/rules.db

# Optional basic auth for the web UI. Strongly recommended if you publish
# the port beyond localhost.
# UI_USER=admin
# UI_PASSWORD=change-me
